// Schema do CRM Genesis — MongoDB.
//
// Notas da migração vinda do PostgreSQL:
//  - Todo `id` precisa de @map("_id"), exigência do conector MongoDB.
//  - `Decimal` não existe neste conector. Dinheiro passou a ser Int em
//    CENTAVOS (`valueCents`), renomeado de propósito: qualquer ponto do código
//    que não foi convertido vira erro de compilação em vez de erro por 100×.
//    Teto do Int: 2.147.483.647 centavos = R$ 21.474.836,47 por registro.
//  - Não há histórico de migrações no MongoDB; o schema é aplicado com
//    `prisma db push`. As migrações antigas ficaram em
//    prisma/migrations.postgres-backup/ caso o Postgres volte um dia.
//  - As ações referenciais (Cascade/SetNull) são emuladas pelo Prisma no
//    cliente, não pelo banco.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum StageType {
  OPEN
  WON
  LOST
}

enum ServiceType {
  SITE
  SAAS
  ERP
  AUTOMACAO
  IA
  OUTRO
}

enum ProposalStatus {
  DRAFT
  GENERATING
  AWAITING
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

enum BlockState {
  EMPTY
  GENERATING
  READY
}

enum MessageAuthor {
  AGENT
  USER
}

enum IdeaStatus {
  BACKLOG
  RESEARCHING
  VALIDATING
  BUILDING
  LAUNCHED
  DISCARDED
}

enum EffortLevel {
  LOW
  MEDIUM
  HIGH
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

model Organization {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  memberships    OrganizationMembership[]
  pipelineStages PipelineStage[]
  lossReasons    LossReason[]
  companies      Company[]
  contacts       Contact[]
  deals          Deal[]
  activities     Activity[]
  ideas          Idea[]
  proposals      Proposal[]
}

model User {
  id           String   @id @default(cuid()) @map("_id")
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships OrganizationMembership[]
  activities  Activity[]
  ideas       Idea[]
}

model OrganizationMembership {
  id             String         @id @default(cuid()) @map("_id")
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model PipelineStage {
  id             String    @id @default(cuid()) @map("_id")
  organizationId String
  name           String
  order          Int
  type           StageType @default(OPEN)
  createdAt      DateTime  @default(now())

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals            Deal[]
  stageHistoryFrom StageHistory[] @relation("FromStage")
  stageHistoryTo   StageHistory[] @relation("ToStage")

  @@unique([organizationId, order])
}

model LossReason {
  id             String   @id @default(cuid()) @map("_id")
  organizationId String
  label          String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deals        Deal[]

  @@unique([organizationId, label])
}

model Company {
  id             String   @id @default(cuid()) @map("_id")
  organizationId String
  name           String
  website        String?
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]
  proposals    Proposal[]
}

model Contact {
  id             String   @id @default(cuid()) @map("_id")
  organizationId String
  companyId      String?
  name           String
  email          String?
  phone          String?
  role           String?
  source         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
}

model Deal {
  id                String      @id @default(cuid()) @map("_id")
  organizationId    String
  title             String
  contactId         String?
  companyId         String?
  stageId           String
  /// Valor em centavos. Ver nota de dinheiro no topo do arquivo.
  valueCents        Int         @default(0)
  currency          String      @default("BRL")
  serviceType       ServiceType @default(OUTRO)
  status            DealStatus  @default(OPEN)
  lostReasonId      String?
  expectedCloseDate DateTime?
  closedAt          DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  stage        PipelineStage  @relation(fields: [stageId], references: [id])
  lostReason   LossReason?    @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  activities   Activity[]
  stageHistory StageHistory[]
  proposals    Proposal[]

  @@index([organizationId, status])
}

model StageHistory {
  id          String   @id @default(cuid()) @map("_id")
  dealId      String
  fromStageId String?
  toStageId   String
  changedAt   DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Uma etapa excluída leva o histórico junto — getFunnel só reporta etapas
  // que ainda existem, então registros órfãos seriam peso morto.
  fromStage PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage   PipelineStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

model Activity {
  id              String       @id @default(cuid()) @map("_id")
  organizationId  String
  dealId          String?
  contactId       String?
  type            ActivityType
  body            String
  dueAt           DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  @@index([dealId])
}

/// Proposta comercial gerada a partir de um negócio. O documento é uma lista
/// ordenada de blocos, cada um preenchível pelo agente de IA separadamente.
model Proposal {
  id             String         @id @default(cuid()) @map("_id")
  organizationId String
  dealId         String?
  companyId      String?
  /// Identificador da URL, único dentro da organização.
  slug           String
  title          String
  status         ProposalStatus @default(DRAFT)
  /// Valor em centavos. Ver nota de dinheiro no topo do arquivo.
  valueCents     Int            @default(0)
  currency       String         @default("BRL")
  /// Quantas vezes o cliente abriu o link; 0 enquanto não enviada.
  views          Int            @default(0)
  lastViewedAt   DateTime?
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deal         Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  blocks       ProposalBlock[]
  messages     ProposalMessage[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model ProposalBlock {
  id         String     @id @default(cuid()) @map("_id")
  proposalId String
  order      Int
  label      String
  content    String?
  state      BlockState @default(EMPTY)
  updatedAt  DateTime   @updatedAt

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, order])
}

/// Conversa com o agente sobre esta proposta.
model ProposalMessage {
  id         String        @id @default(cuid()) @map("_id")
  proposalId String
  author     MessageAuthor
  text       String
  createdAt  DateTime      @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

/// Backlog de produtos que a Genesis considera construir — tipicamente
/// ferramentas que já existem lá fora e ainda não têm equivalente no Brasil.
model Idea {
  id             String      @id @default(cuid()) @map("_id")
  organizationId String
  title          String
  description    String?
  /// Produto de referência lá fora e seu site, quando a ideia parte de um.
  referenceName  String?
  referenceUrl   String?
  category       ServiceType @default(SAAS)
  status         IdeaStatus  @default(BACKLOG)
  /// Potencial percebido de 1 a 5; combinado com `effort` ordena o backlog.
  potential      Int         @default(3)
  effort         EffortLevel @default(MEDIUM)
  targetAudience String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  /// Opcional e SetNull: remover um membro não pode apagar as ideias dele.
  createdByUserId String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}
